NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Optional: full EVM transaction history (Etherscan v2 multi-chain API). Without it,
# EVM history falls back to ERC-20 transfers read from each chain's public RPC.
NEXT_PUBLIC_ETHERSCAN_API_KEY=
# Contract Builder compile service for Sui, Aptos, Stellar, Solana and Starknet
# (txio-backend/compiler). Solidity compiles in the browser and needs nothing.
NEXT_PUBLIC_COMPILER_URL=http://localhost:8090
